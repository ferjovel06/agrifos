erDiagram
    %% SQLAlchemy models at feat/npk-measurement-reliability 19df436; 2026-10-09.
    %% Legacy readings require all seven values; contract v1 preserves only measured variables.
    %% Canonical originals, results and paired evidence are immutable; derived_results is a cache projection.
    PARCEL ||--o{ READING : parcel_id
    PARCEL ||--o{ LAB_ANALYSIS : parcel_id
    READING ||--o{ READING_RESULT : reading_id
    READING ||--o{ CALIBRATION_PAIR_RECORD : reading_id
    USER ||--o{ CALIBRATION_PAIR_RECORD : user_id
    USER ||--o{ SENSOR_CALIBRATION : user_id
    SENSOR_CALIBRATION o|--o{ READING_RESULT : calibration_id
    PARCEL {
        int revision
        uuid farm_id FK
        uuid crop_id FK
        uuid variety_id FK "nullable"
        string name
        float area_hectares
        int plants_per_hectare "nullable"
        date planting_date
        uuid id PK
        datetime created_at
        datetime updated_at
    }
    READING {
        int revision
        uuid parcel_id FK
        float nitrogen "nullable for contract v1"
        float phosphorus "nullable for contract v1"
        float potassium "nullable for contract v1"
        float ec "nullable for contract v1"
        float ph "nullable for contract v1"
        float temperature "nullable for contract v1"
        float humidity "nullable for contract v1"
        jsonb measurement "nullable legacy; immutable provenance"
        jsonb derived_results "non-null cache projection"
        timestamptz received_at "nullable legacy; unknown historical reception"
        datetime recorded_at
        uuid id PK
    }
    %% reading_results: UNIQUE(reading_id, fingerprint).
    READING_RESULT {
        uuid id PK
        uuid reading_id FK
        string fingerprint
        string algorithm_version
        uuid calibration_id FK "nullable"
        jsonb payload
        timestamptz created_at
    }
    %% sensor_calibration_pairs: UNIQUE(user_id, reading_id, variable).
    %% context_key groups known session/point/device/parcel/depth repetitions.
    CALIBRATION_PAIR_RECORD {
        uuid id PK
        uuid user_id FK
        uuid reading_id FK
        string sample_id
        string context_key "nullable when point unknown"
        string variable
        jsonb laboratory "method, basis, units, depth and reference evidence"
        timestamptz created_at
    }
    %% sensor_calibrations: UNIQUE(user_id, profile_id, version).
    %% pair_ids stores UUIDs in JSONB; application reauthorizes originals (no FK).
    SENSOR_CALIBRATION {
        uuid id PK
        uuid user_id FK
        string profile_id
        int version
        string state "candidate / validated / retired"
        jsonb profile "immutable candidate version"
        jsonb pair_ids
        jsonb validation "nullable; immutable server validation evidence"
        timestamptz created_at
    }
    LAB_ANALYSIS {
        int revision
        uuid parcel_id FK
        string sample_code "nullable"
        datetime sampled_at "nullable"
        float depth_start_cm "nullable"
        float depth_end_cm "nullable"
        float ph
        string ph_method "nullable"
        float ec "nullable"
        string ec_method "nullable"
        float organic_matter_pct
        float cic
        float clay_pct
        float silt_pct
        float sand_pct
        float nitrogen
        float phosphorus
        string phosphorus_method "nullable"
        float potassium
        string potassium_method "nullable"
        float calcium
        float magnesium
        float sulfur
        string lab
        datetime recorded_at
        uuid id PK
    }
