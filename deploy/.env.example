# Private Compose environment: copy to deploy/.env (ignored), chmod 600 on Linux.
# Obtain database settings from FerJovel. Never commit actual credentials.
API_ENV_FILE=deploy/backend.env
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_PRIVATE_DATABASE_PASSWORD@db:5432/agrifos
ALLOWED_ORIGINS=https://app.example.org
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
POSTGRES_VOLUME=agrifos-postgres-data
POSTGRES_VOLUME_EXTERNAL=false
DB_MEMORY_LIMIT=2g
DB_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.0
PROXY_MEMORY_LIMIT=128m
