# Local-development defaults. Override these in Render with production values.
ENV=development
APP_DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:example_password@127.0.0.1:54321/postgres
DB_POOL_SIZE=10
DB_POOL_RECYCLE_SECONDS=300
SUPABASE_URL=https://your-project-ref.supabase.co
AUTH_PROVIDER=supabase
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=agrifos
AUTH_JWT_AUDIENCE=agrifos-api
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_MFA_ENCRYPTION_KEY=
AUTH_MFA_CHALLENGE_SECONDS=300
AUTH_MAX_MFA_ATTEMPTS=5
AUTH_MFA_LOCK_SECONDS=300
AUTH_MFA_ENROLLMENT_SECONDS=600
AUTH_MFA_ISSUER=Agrifos
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_EMAIL_TOKEN_SECONDS=1800
AUTH_EMAIL_COOLDOWN_SECONDS=60
AUTH_EMAIL_REDIRECT_URL=dev.agrifos.agrifos://auth-callback/
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_FALLBACK_API_BASE_URL=https://api.met.no/weatherapi/locationforecast/2.0
WEATHER_FALLBACK_USER_AGENT=Agrifos/0.1 https://github.com/ferjovel06/agrifos
